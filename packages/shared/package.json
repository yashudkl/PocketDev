{
  "name": "@pocketdev/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared TypeScript contracts across PocketDev: queue payloads, PTY WebSocket protocol, and file-sync protocol.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"(lint: skipped for shared)\"",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "typescript": "~5.9.2"
  }
}
