{
  "name": "pocketdev",
  "version": "0.1.0",
  "private": true,
  "description": "PocketDev — a mobile-native cloud development environment. Sync your local codebase, then browse, edit, run, and commit from your phone in a real terminal.",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "turbo run clean && rimraf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "server:dev": "pnpm --filter @pocketdev/server start:dev",
    "mobile:dev": "pnpm --filter mobile dev",
    "worker:dev": "pnpm --filter @pocketdev/execution-worker dev",
    "db:generate": "pnpm --filter @pocketdev/server db:generate",
    "db:migrate": "pnpm --filter @pocketdev/server db:migrate"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "~5.9.2",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "node-pty"
    ]
  }
}
