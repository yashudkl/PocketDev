# Root env reference for PocketDev. Copy the per-workspace bits into each app's
# own .env (server/.env, mobile/.env). This file documents everything in one place.

# ─── Server (server/.env) ────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://postgres:pocketdev@localhost:5432/pocketdev?schema=public"
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRES_IN=7d

# ─── Mobile (mobile/.env) ────────────────────────────────────────────────────
# Android emulator -> http://10.0.2.2:3000 ; iOS sim -> http://localhost:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# ─── Desktop agent (services/desktop-agent) ──────────────────────────────────
DESKTOP_AGENT_PORT=4000
POCKETDEV_API_URL=http://localhost:3000
POCKETDEV_TOKEN=
POCKETDEV_TUNNEL_URL=
