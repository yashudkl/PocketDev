# Root env reference for PocketDev. Copy the per-workspace bits into each app's
# own .env (server/.env, mobile/.env). This file documents everything in one place.

# ─── Server (server/.env) ────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://postgres:pocketdev@localhost:5432/pocketdev?schema=public"
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRES_IN=7d
# Where the CLI agent's synced project files are stored on disk. The execution
# worker bind-mounts subfolders of this into containers (share it on one VM).
FILE_STORE_ROOT=./.pocketdev-store
# Public WS URL of the cloud worker's PTY gateway (handed to the phone for CLOUD
# terminal sessions). Behind Caddy in production, e.g. wss://host/cloud-pty.
WORKER_WS_URL=ws://localhost:4100
# TTL of the per-session PTY token the API mints for the phone.
PTY_TOKEN_TTL=5m
# A desktop counts as "online" if it heartbeat within this window (ms).
DESKTOP_HEARTBEAT_WINDOW_MS=30000

# ─── Execution worker (services/execution-worker) ────────────────────────────
# Shares REDIS_* and JWT_SECRET with the server. Its own knobs:
WORKER_PTY_PORT=4100
FILE_STORE_ROOT=./.pocketdev-store
# Docker runtime for user containers: "runc" (default) or "runsc" (gVisor, Week 8).
EXECUTION_RUNTIME=runc
# Base image user commands run inside.
EXECUTION_IMAGE=node:22-bookworm-slim
# Per-container caps.
EXECUTION_MEMORY_MB=512
EXECUTION_CPUS=1
EXECUTION_PIDS_LIMIT=256
# Give containers outbound network (needed for npm/pip installs in a demo). 0 = --network none.
EXECUTION_NETWORK=1
# Max concurrent CLOUD sessions per worker = the FREE-tier shared pool size.
WORKER_CONCURRENCY=2
# Seconds the worker holds a provisioned container waiting for the phone to attach.
SESSION_CONNECT_TIMEOUT_S=60
# Wall-clock cap on a single session (s).
SESSION_MAX_DURATION_S=1800

# ─── Mobile (mobile/.env) ────────────────────────────────────────────────────
# Android emulator -> http://10.0.2.2:3000 ; iOS sim -> http://localhost:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# ─── Desktop agent (services/desktop-agent) ──────────────────────────────────
DESKTOP_AGENT_PORT=4000
POCKETDEV_API_URL=http://localhost:3000
POCKETDEV_TOKEN=
POCKETDEV_TUNNEL_URL=
# Shell the desktop agent runs (defaults: pwsh/cmd on Windows, bash elsewhere).
DESKTOP_SHELL=
# Root under which desktop sessions open (defaults to the linked project dir).
DESKTOP_PROJECT_ROOT=
# Shares JWT_SECRET with the server to verify PTY tokens.
JWT_SECRET=change-me-in-production-use-a-long-random-string
