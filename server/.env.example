# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Database (PostgreSQL via Prisma) ────────────────────────────────────────
# Local dev: run Postgres in Docker, e.g.
#   docker run --name pocketdev-pg -e POSTGRES_PASSWORD=pocketdev -e POSTGRES_DB=pocketdev -p 5432:5432 -d postgres:16
DATABASE_URL="postgresql://postgres:pocketdev@localhost:5432/pocketdev?schema=public"

# ─── Redis (BullMQ queue + ephemeral state) ──────────────────────────────────
# Local dev: docker run --name pocketdev-redis -p 6379:6379 -d redis:7
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Auth (JWT) ──────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRES_IN=7d
