{
  "name": "@pocketdev/cli-agent",
  "version": "0.1.0",
  "private": true,
  "description": "PocketDev CLI sync agent — watches a local project with chokidar and delta-syncs changed files to the server over WebSocket (Build Plan, Weeks 3–4).",
  "main": "dist/index.js",
  "bin": {
    "pocketdev": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"(lint: skipped for cli-agent scaffold)\"",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@pocketdev/shared": "workspace:*",
    "chokidar": "^4.0.3",
    "commander": "^12.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/ws": "^8.5.13",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "~5.9.2"
  }
}
