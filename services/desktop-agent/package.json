{
  "name": "@pocketdev/desktop-agent",
  "version": "0.1.0",
  "private": true,
  "description": "PocketDev desktop agent — runs the same PTY-over-WebSocket server locally and heartbeats presence to the API so execution can route to the developer's own machine (Build Plan, Decision 4 / Weeks 9–10).",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"(lint: skipped for desktop-agent scaffold)\"",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@pocketdev/shared": "workspace:*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/ws": "^8.5.13",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "~5.9.2"
  }
}
